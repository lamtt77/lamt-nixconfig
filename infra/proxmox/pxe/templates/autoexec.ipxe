#!ipxe
dhcp
menu PXE Boot Menu for @HOSTNAME@
item proxmox-auto Setup Proxmox VE (Auto-Install)
item proxmox-auto-debug Setup Proxmox VE (Auto-Install Debug)
item proxmox Setup Proxmox VE (Manual)
@BOOT_SELECTION@
goto ${target}

:proxmox
kernel http://@BOOTSTRAP_IP@/proxmox/linux26 intel_iommu=on iommu=pt \
  vga=791 video=vesafb:ywrap,mtrr ro ramdisk_size=16777216 \
  @CONSOLE_ARGS@ rw quiet splash=silent
initrd http://@BOOTSTRAP_IP@/proxmox/initrd
boot
goto end

:proxmox-auto
kernel http://@BOOTSTRAP_IP@/proxmox/linux26 intel_iommu=on iommu=pt \
  vga=791 video=vesafb:ywrap,mtrr ro ramdisk_size=16777216 \
  @CONSOLE_ARGS@ rw quiet splash=silent \
  proxmox-start-auto-installer
initrd http://@BOOTSTRAP_IP@/proxmox/initrd
boot
goto end

:proxmox-auto-debug
kernel http://@BOOTSTRAP_IP@/proxmox/linux26 intel_iommu=on iommu=pt \
  vga=791 video=vesafb:ywrap,mtrr ro ramdisk_size=16777216 \
  @CONSOLE_ARGS@ rw quiet splash=silent \
  proxmox-start-auto-installer proxdebug
initrd http://@BOOTSTRAP_IP@/proxmox/initrd
boot
goto end

:end
